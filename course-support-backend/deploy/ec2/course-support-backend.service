[Unit]
Description=Course Support Backend
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/course-support-backend
EnvironmentFile=/home/ubuntu/course-support-backend/.env
ExecStart=/home/ubuntu/course-support-backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
